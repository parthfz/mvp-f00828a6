# Backend configuration — copy to .env and fill in real values.
APP_NAME=bistro-cafe-ordering
APP_TITLE=Bistro & Cafe Ordering
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (asyncpg). On Render this is provided as DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=a3MZJhB_c0Js7tT7luev1VgZSQu2c2jGtqqV8RfYjoRwPjOL-ufD7I2N7Xwc3Zs6
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BACKEND_PORT=8000
LOG_LEVEL=info

# External integrations (leave blank if unused)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=